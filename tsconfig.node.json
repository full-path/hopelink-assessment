{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // DOM is here for the tests, not for scripts/: src/app.render.test.ts mounts the real app
    // into a happy-dom document.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "types": ["node", "vitest/globals"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["scripts", "src/**/*.test.ts", "vite.config.ts"]
}
